font-family = ComicShannsMono Nerd Font Mono
theme = light:Atom One Light,dark:Andromeda
macos-option-as-alt = true
# The Ghostty default sends ESC b for Option+Left, which is the same as Cmd+B
# (nvim file tree). Send real Alt+arrow sequences instead.
keybind = alt+arrow_left=csi:1;3D
keybind = alt+arrow_right=csi:1;3C

# VS Code-style Cmd shortcuts for nvim. Each Cmd shortcut is sent as
# Alt+<key> (ESC <key>); nvim maps <M-key>.
keybind = cmd+p=text:\x1bp
keybind = cmd+shift+p=text:\x1bP
keybind = cmd+shift+f=text:\x1bF
keybind = cmd+b=text:\x1bb
keybind = cmd+s=text:\x1bs
keybind = cmd+j=text:\x1bj
keybind = cmd+slash=text:\x1b/
keybind = cmd+shift+v=text:\x1bV
