IgnoreUnknown UseKeychain
# Keep the line above first. UseKeychain is macOS only, and OpenSSH on Linux
# stops on unknown options.

Include ~/.ssh/config.local

Host github.com
    IdentitiesOnly yes

Host *.compute.amazonaws.com
    User ec2-user

Host *
    ForwardAgent yes
    AddKeysToAgent yes
    UseKeychain yes
    ServerAliveInterval 60
