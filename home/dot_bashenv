_lc()          { command "$@"; }
_lc_compress() { command "$@"; }
lean_ctx_track()    { command "$@"; }
lean_ctx_compress() { command "$@"; }
if [[ -z "$LEAN_CTX_ACTIVE" && -z "$LEAN_CTX_DISABLED" && -z "$LEAN_CTX_NO_HOOK" && -n "$BASH_EXECUTION_STRING" ]] \
  && [[ "$BASH_EXECUTION_STRING" != *"__CURSOR_SANDBOX"* ]] \
  && [[ "$BASH_EXECUTION_STRING" != *"dump_zsh_state"* ]] \
  && [[ "$BASH_EXECUTION_STRING" != *"lean-ctx hook "* ]] \
  && command -v lean-ctx &>/dev/null; then
  if [[ -n "$LEAN_CTX_AGENT" || -n "$CLAUDECODE" || -n "$CODEBUDDY" || -n "$CODEX_CLI_SESSION" || -n "$GEMINI_SESSION" ]]; then
    export LEAN_CTX_ACTIVE=1
    exec lean-ctx -c "$BASH_EXECUTION_STRING"
  fi
fi
